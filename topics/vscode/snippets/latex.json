{
	// Place your snippets for latex here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	//
	// You can also restrict snippets to specific files using include/exclude patterns:
	// "Test snippet": {
	// 	"prefix": "test",
	// 	"body": "test('$1', () => {\n\t$0\n});",
	// 	"include": ["**/*.test.ts", "*.spec.ts"],
	// 	"exclude": ["**/temp/*.ts"],
	// 	"description": "Insert test block"
	// }
	"$f(x)$": {
		"prefix": ["@$", "equation"],
		"body": "$$1$",
	},
	"\\frac{\\partial}{\\partial x}": {
		"prefix": "partial derivative fraction",
		"body": "\\frac{\\partial${1:}}{\\partial ${2:x}}",
	},


	"\\label{eq:<equation label>}": {
		"prefix": "label equation",
		"body": "\\label{eq:${1:<equation label>}}",
	},
	"\\label{fig:<figure label>}": {
		"prefix": "label figure",
		"body": "\\label{fig:${1:<figure label>}}",
	},
	"\\label{section:<section label>}": {
		"prefix": "label section",
		"body": "\\label{section:${1:<section label>}}",
	},

	"Equation \\ref{eq:<equation label>}": {
		"prefix": "equation ref",
		"body": "Equation \\ref{eq:${1:<equation label>}}",
	},
	"Figure \\ref{fig:<figure label>}": {
		"prefix": "figure ref",
		"body": "Figure \\ref{fig:${1:<figure label>}}",
	},
	"\\S\\ref{section:<section label>}": {
		"prefix": "section ref",
		"body": "\\S\\ref{section:${1:<section label>}}",
	},

	"\\mathbb{E}[ f(x) ]": {
		"prefix": "expectation",
		"body": "\\mathbb{E}\\left[ ${1:f(x)} \\right]",
	},
	"\\text{Var}[ f(x) ]": {
		"prefix": "variance",
		"body": "\\text{Var}\\left[ ${1:f(x)} \\right]",
	},
	"\\mathcal{N}( x | \\mu, \\sigma^2 )": {
		"prefix": ["normal", "gaussian"],
		"body": "\\mathcal{N}\\left( ${1:x} \\,\\middle|\\, ${2:\\mu}, ${3:\\sigma^2} \\right)",
	},
	"\\text{where}\\quad ": {
		"prefix": "where",
		"body": "\\text{where}\\quad ",
	},
	"\\Rightarrow\\quad ": {
		"prefix": "rightarrow",
		"body": "\\Rightarrow\\quad ",
	},
}
